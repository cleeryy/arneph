# Supabase — copier vers .env.local puis renseigner (voir `supabase status`).
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url

# Clé publique côté navigateur : l'une ou l'autre suffit.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Alternative moderne Supabase (`sb_publishable_...`).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clé serveur, jamais exposée au navigateur : l'une ou l'autre suffit.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
# Alternative moderne Supabase (`sb_secret_...`).
SUPABASE_SECRET_KEY=

# Optionnel : cache-buster des URLs Storage (incrémenter après un remplacement d'asset).
NEXT_PUBLIC_ASSET_VERSION=
